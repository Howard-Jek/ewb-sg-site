# Vercel → Project → Settings → Environment Variables (Production).
SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase → Project Settings → API Keys → Secret key (sb_secret_…). Server-only; mark Sensitive.
SUPABASE_SECRET_KEY=
# Optional, comma-separated. Extra origins allowed to POST /api/forms when they
# differ from the request host (normally not needed).
ALLOWED_ORIGINS=
